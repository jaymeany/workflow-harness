{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/load-first-start-check.sh",
            "$comment": "First start: while any {{placeholder}} remains, tells the session to run FIRST_START.md before anything else. Silent once setup is done."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/load-orchestrator-role.sh",
            "$comment": "Loads load-orchestrator-role.sh at session start."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/load-orchestrator-protocol.sh",
            "$comment": "Loads load-orchestrator-protocol.sh at session start."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/load-orchestrator-cards.sh",
            "$comment": "Loads load-orchestrator-cards.sh at session start."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/load-agent-comms.sh",
            "$comment": "Loads load-agent-comms.sh at session start."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/audit-fail-open.sh",
            "$comment": "Loads audit-fail-open.sh at session start."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/load-status-digest.sh",
            "$comment": "Loads load-status-digest.sh at session start."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-destructive-bash.sh",
            "$comment": "Guard: block-destructive-bash.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/deny-direct-trello-api.sh",
            "$comment": "Guard: deny-direct-trello-api.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "$comment": "Handoff gate on compaction. Matcher manual|auto covers BOTH paths: a context-wall freeze ends in a manual /compact, which would otherwise be the one ungated door. Refuses once per session when handoffs/orchestrator-handoff-YYYY-MM-DD.md is missing or older than HANDOFF_FRESHNESS_SECONDS, then yields so a wedged session is never trapped. How hard it pushes is a preference: HANDOFF_GATE in ../shared/handoffs.conf is block, warn or off. ONE shared script serves every role, like board/board.sh. Fails open on missing $CLAUDE_PROJECT_DIR, missing handoffs dir, or an unstattable file.",
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/../shared/precompact-write-handoff.sh"
          }
        ]
      }
    ]
  }
}
